    <Rectangle id="statusBackground" translation="[120,900]" width="1680" height="100" color="0x080DCCDD" visible="false" />
    <Label id="status" translation="[155,920]" width="1610" height="60" color="0xFFFFFFFF" font="font:MediumSystemFont" visible="false" />
  </children>
</component>
