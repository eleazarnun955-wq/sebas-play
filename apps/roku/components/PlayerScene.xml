<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScene" extends="Group">
  <interface>
    <field id="videoUrl" type="string" />
    <field id="videoTitle" type="string" />
    <field id="wasClosed" type="boolean" value="false" />
    <field id="errorMessage" type="string" value="" />
  </interface>
  <script type="text/brightscript" uri="PlayerScene.brs" />
  <children>
    <Video id="video" width="1920" height="1080" />
    <Label id="errorLabel" visible="false" width="1500" translation="[210,780]" color="#FFFFFF" font="font:MediumSystemFont" />
  </children>
</component>
