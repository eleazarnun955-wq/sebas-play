<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScene" extends="Group">
  <interface>
    <field id="videoUrl" type="string" />
    <field id="videoTitle" type="string" />
    <field id="wasClosed" type="boolean" value="false" />
    <field id="errorMessage" type="string" value="" />
    <field id="syncToken" type="string" value="" />
    <field id="contentType" type="string" value="" />
    <field id="contentId" type="string" value="" />
    <field id="resumeSeconds" type="integer" value="0" />
  </interface>
  <script type="text/brightscript" uri="PlayerScene.brs" />
  <children>
    <Timer id="progressSaveTimer" duration="10" repeat="true" />
    <Video id="video" width="1920" height="1080" enableUI="true" />
    <Rectangle width="1600" height="90" translation="[160,35]" color="0x00000099" />
    <Label id="titleLabel" translation="[190,48]" width="1500" height="60" color="#FFFFFF" font="font:MediumSystemFont" />
    <Label id="loadingLabel" translation="[210,780]" width="1500" height="65" color="#FFFFFF" font="font:LargeSystemFont" />
    <Label id="errorLabel" visible="false" translation="[210,780]" width="1500" height="100" color="#FFB0B0" font="font:MediumSystemFont" />
  </children>
</component>
