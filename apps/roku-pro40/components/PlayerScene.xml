<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScene" extends="Group">
  <interface>
    <field id="videoUrl" type="string" />
    <field id="videoTitle" type="string" />
    <field id="wasClosed" type="boolean" value="false" />
  </interface>
  <script type="text/brightscript" uri="PlayerScene.brs" />
